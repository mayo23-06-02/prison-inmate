{
  "expo": {
    "name": "prison-inmate",
    "slug": "prison-inmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hms.png",
    "scheme": "prisoninmate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/hms.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/hms.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/hms.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/hms.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
